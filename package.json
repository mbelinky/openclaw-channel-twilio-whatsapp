{
  "name": "@mbelinky/openclaw-channel-twilio-whatsapp",
  "version": "3.0.3",
  "license": "Apache-2.0",
  "description": "Maintained multi-account Twilio WhatsApp channel plugin for OpenClaw",
  "author": "Mariano Belinky",
  "contributors": [
    "srinathh (original author)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbelinky/openclaw-channel-twilio-whatsapp.git"
  },
  "bugs": {
    "url": "https://github.com/mbelinky/openclaw-channel-twilio-whatsapp/issues"
  },
  "homepage": "https://github.com/mbelinky/openclaw-channel-twilio-whatsapp#readme",
  "type": "module",
  "main": "dist/index.js",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "twilio-whatsapp",
      "label": "Twilio WhatsApp",
      "selectionLabel": "WhatsApp (Twilio Business API)",
      "blurb": "WhatsApp channel via Twilio Business API, with official delivery receipts.",
      "markdownCapable": true,
      "exposure": {
        "configured": true,
        "setup": true,
        "docs": true
      },
      "quickstartAllowFrom": true
    },
    "install": {
      "clawhubSpec": "clawhub:@mbelinky/openclaw-channel-twilio-whatsapp",
      "npmSpec": "@mbelinky/openclaw-channel-twilio-whatsapp",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.6.11"
    },
    "compat": {
      "pluginApi": ">=2026.6.11",
      "minGatewayVersion": "2026.6.11"
    },
    "build": {
      "openclawVersion": "2026.6.11",
      "pluginSdkVersion": "2026.6.11"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "AGENT_INSTRUCTIONS.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.mjs"
  },
  "dependencies": {
    "mime-types": "^3.0.2",
    "twilio": "^6.0.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.11"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.0.0",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.0.0"
  }
}
